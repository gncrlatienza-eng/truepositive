# Copy to .env and fill in real values. .env is gitignored — never commit it.
# See README.md's "Environment Variables" section for what each one does.

# --- Postgres (used by the postgres and backend services in docker-compose.yml) ---
# Dev defaults if left unset: truepositive / truepositive. Set real values
# before running docker-compose.prod.yml — that overlay refuses to start
# without a real POSTGRES_PASSWORD.
POSTGRES_USER=truepositive
POSTGRES_PASSWORD=truepositive

# --- Backend ---
# Only needed if running the backend standalone (outside Docker) — inside
# Docker, docker-compose.yml already points DATABASE_URL at the postgres
# container using POSTGRES_USER/POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://truepositive:truepositive@localhost:5432/truepositive

# Required — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

JWT_EXPIRE_MINUTES=43200
CORS_ORIGINS=http://localhost:3000

# Required — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Frontend ---
# Leave unset/blank for the normal case (dev and prod both default to a
# relative "/api" path, proxied to the backend by Vite's dev server or by
# nginx/Caddy in prod — see frontend/src/utils/api.js). Only set this if the
# frontend needs to call a backend that ISN'T reachable via that same-origin
# proxy (e.g. a separately hosted API on its own domain).
VITE_API_URL=

# --- Production only (docker-compose.prod.yml) ---
# A real domain whose DNS already points at this host — Caddy uses it to
# request a Let's Encrypt certificate. See Caddyfile.
DOMAIN=

# --- Tailscale deployment only (docker-compose.tailscale.yml) ---
# Your machine's Tailscale MagicDNS name (run `tailscale status` to find it,
# or check the Tailscale admin console) — e.g. gio.tailnet-name.ts.net. Used
# for CORS_ORIGINS; `tailscale serve` (run separately, see README.md) is what
# actually issues the HTTPS cert and proxies traffic in from the tailnet.
TS_HOSTNAME=
