# ==============================
# Environment variables & secrets
# ==============================
# All .env files are ignored, no exceptions — including .env.example.
# Required variables are documented in README.md instead of a committed template.
.env
.env.*
*.pem
*.key
*.crt
*.p12
secrets/
credentials.json
# Per-agent enrollment config downloaded from the dashboard (agent/tp_agent.py) — contains a real key.
agent_config.json
# Per-source collection bookmarks (Sprint 5) — machine-local runtime state, not source.
agent_state.json

# ==============================
# Claude workspace (not committed)
# ==============================
.claude/
claude.md

# ==============================
# Local-only planning/reference material (not for the public repo)
# ==============================
reference/

# ==============================
# Dependencies
# ==============================
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# ==============================
# Build artifacts
# ==============================
dist/
build/
*.egg-info/
.next/
out/

# ==============================
# IDE files
# ==============================
.vscode/
.idea/
*.swp
*.swo

# ==============================
# OS files
# ==============================
.DS_Store
Thumbs.db

# ==============================
# Logs & temp files
# ==============================
*.log
# Root-anchored (not "logs/") — an unanchored pattern here silently matched
# frontend/src/components/logs/ too, which meant `git add -A` never staged a
# real, already-built component (LogDetailModal.jsx) despite it existing on
# disk and being imported by LogsPage.jsx — invisible locally (the file was
# still there for `npm run build` to resolve), only surfaced as a Linux CI
# build failure ("Could not resolve ... LogDetailModal") since a fresh clone
# never had the file at all.
/logs/
/tmp/
*.tmp

# ==============================
# Docker overrides
# ==============================
docker-compose.override.yml
.docker/*
