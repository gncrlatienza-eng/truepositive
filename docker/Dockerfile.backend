FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# Don't run the API as root -- a code-execution bug in the app (or a
# dependency) shouldn't also hand over root inside the container.
RUN useradd --system --uid 10001 --no-create-home appuser     && mkdir -p /app/agent_dist && chown appuser /app/agent_dist
USER appuser

EXPOSE 8000
# Migrations run on every start (idempotent), so a host with no shell access
# (Render) stays on the latest schema. fetch_agent_binaries is a no-op unless
# AGENT_RELEASE_URL is set. PORT is set by Render; 8000 everywhere else.
CMD ["sh", "-c", "alembic upgrade head && python scripts/fetch_agent_binaries.py && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
