FROM node:22-slim AS build

WORKDIR /app
# Install from the lockfile (same as CI's `npm ci`) so the image builds the
# exact dependency versions that were reviewed, not whatever resolves today.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .
# Optional override — leave unset to build with the relative "/api" default
# (see frontend/src/utils/api.js), which works behind nginx's proxy in any
# environment without a rebuild.
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000
