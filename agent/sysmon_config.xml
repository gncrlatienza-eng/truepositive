<!--
  Default Sysmon configuration installed by tp_agent.py's "Install Sysmon"
  action (see install_sysmon()). Deliberately compact rather than a full
  community ruleset (e.g. SwiftOnSecurity's), self-authored to avoid any
  licensing/attribution question from bundling a specific third-party file
  verbatim, and scoped to the handful of event types that give the best
  detection value for the least noise: process creation, network
  connections, process-injection indicators, executable/script file drops
  (plus the FileCreateTime "timestomp" tamper indicator).
  onmatch="exclude" means "log everything of this type except what's
  excluded below"; onmatch="include" means "log only what's listed". Adjust/replace via Settings if you need something more
  targeted; the agent never overwrites a config file it didn't just install.
-->
<Sysmon schemaversion="4.91">
  <EventFiltering>
    <RuleGroup name="" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <!-- High-volume, low-value default noise. -->
        <Image condition="end with">conhost.exe</Image>
      </ProcessCreate>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <DestinationIp condition="is">127.0.0.1</DestinationIp>
      </NetworkConnect>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <!-- Timestamp tampering on an existing file is a common
           anti-forensics / ransomware indicator. -->
      <FileCreateTime onmatch="exclude" />
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <!-- An empty include logs nothing: process exits were the single
           largest event type (~30% of volume) with no detection value,
           which matters on a free-tier database. -->
      <ProcessTerminate onmatch="include" />
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <!-- Classic process-injection technique. -->
      <CreateRemoteThread onmatch="exclude" />
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <!-- Only executable/script drops, not every file written (the
           second-largest event type before this was narrowed). -->
      <FileCreate onmatch="include">
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.dll</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.bat</TargetFilename>
        <TargetFilename condition="end with">.cmd</TargetFilename>
        <TargetFilename condition="end with">.vbs</TargetFilename>
        <TargetFilename condition="end with">.js</TargetFilename>
        <TargetFilename condition="end with">.hta</TargetFilename>
      </FileCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
